Options -Indexes

# Arquivos enviados por usuários nunca devem ser executados como código.
<FilesMatch "\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|bash|cmd|bat|ps1)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
